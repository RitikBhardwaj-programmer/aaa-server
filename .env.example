# Copy is created by scripts/init.ps1 with random secrets. Do not commit .env.

# --- LDAP directory ---
LDAP_BASE_DN=dc=nitsrinagar,dc=edu
LDAP_DOMAIN=nitsrinagar.edu
LDAP_ORG=NIT Srinagar
LDAP_ADMIN_PASSWORD=change-me
# Read-only service account used by FreeRADIUS (cn=radius,ou=Services,<base>)
LDAP_RADIUS_PASSWORD=change-me
# Password given to all seeded test users (ldap/seed/users.txt)
TEST_USER_PASSWORD=change-me

# --- RADIUS clients (NAS) ---
# Secret for local test tools (radtest / eapol_test)
RADIUS_SECRET_LOCAL=change-me
# The access point (D-Link DIR-X6060). On Docker Desktop for Windows the AP is matched by
# the Docker gateway address instead (see radius/raddb/clients.conf); AP_IP is only used
# if you move the stack to a Linux host with host networking.
AP_IP=192.168.0.1
RADIUS_SECRET_AP=change-me

# --- phpLDAPadmin ---
PLA_APP_KEY=base64:change-me
TZ=Asia/Kolkata
