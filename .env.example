# Copy is created by scripts/init.ps1 with random secrets. Do not commit .env.

# --- LDAP directory ---
LDAP_BASE_DN=dc=nitsrinagar,dc=edu
LDAP_DOMAIN=nitsrinagar.edu
LDAP_ORG=NIT Srinagar
LDAP_ADMIN_PASSWORD=change-me
# Read-only service account used by FreeRADIUS (cn=radius,ou=Services,<base>)
LDAP_RADIUS_PASSWORD=change-me
# Read-only service account used by the self-service portal (cn=portal,ou=Services,<base>); it cannot read password hashes
LDAP_PORTAL_PASSWORD=change-me
# Password given to all seeded test users (ldap/seed/users.txt)
TEST_USER_PASSWORD=change-me

# --- RADIUS clients (NAS) ---
# Secret for local test tools (radtest / eapol_test)
RADIUS_SECRET_LOCAL=change-me
# The access point (D-Link DIR-X6060). On Docker Desktop for Windows the AP is matched by
# the Docker gateway address instead (see radius/raddb/clients.conf); AP_IP is only used
# if you move the stack to a Linux host with host networking.
AP_IP=192.168.0.1
RADIUS_SECRET_AP=change-me

# --- Access revocation ---
# The AP re-checks every connected user this often (seconds). A disabled user loses access
# within this time even when the AP ignores Disconnect-Requests. Lab: 300. Large campus: 3600.
REAUTH_INTERVAL=300

# --- VLAN assignment ---
# yes = every Accept carries the group VLAN (students 10, faculty/staff 20, guests 30).
# no = leave the VLAN attributes out, for a test AP on a network without these VLANs
# (an AP that applies them puts the client on a VLAN with no DHCP, e.g. the Aruba AP-615).
SEND_VLAN=yes

# --- Accounting database (PostgreSQL) ---
# Superuser (used only inside the postgres container) and the FreeRADIUS role "radius"
POSTGRES_PASSWORD=change-me
POSTGRES_RADIUS_PASSWORD=change-me
# Role "portal": SELECT only on radacct, user_devices and device_limit_events (self-service portal)
POSTGRES_PORTAL_PASSWORD=change-me
# The AP sends an accounting update this often (seconds)
ACCT_INTERIM_INTERVAL=600
# A session with no accounting packet for this long is stale: it stops counting toward the
# device limit and the maintenance job closes it. Rule: 2-2.5 x ACCT_INTERIM_INTERVAL.
STALE_SESSION_MINUTES=25
# Keep accounting and login records this many months (CERT-In / DPDP: at least 12)
ACCT_RETENTION_MONTHS=12
# Forget a device (user_devices) not seen for this many days
DEVICE_EXPIRY_DAYS=30
# Maintenance job interval (seconds)
MAINTENANCE_INTERVAL=300

# --- Device limit ---
# Devices a student may have online at the same time (0 = no limit)
DEVICE_LIMIT_STUDENTS=3
# soft = log in device_limit_events and let the device in; enforce = log and reject it
DEVICE_LIMIT_MODE=soft

# --- Failed-login rate limit (replaces account lockout) ---
# Refuse a device after this many rejects for one user in AUTH_REJECT_WINDOW minutes
AUTH_REJECT_LIMIT=10
AUTH_REJECT_WINDOW=15

# --- Login methods (docs/decisions/0002-ldap-only.md) ---
# EAP-TTLS/PAP is the default method. yes = PEAP-MSCHAPv2 still allowed and new users still get an
# NT hash (for devices not yet moved to TTLS); no = PEAP refused and no NT hash for new users.
ALLOW_PEAP=yes

# --- Self-service portal (http://127.0.0.1:8081) ---
# Signs the session cookie and the CSRF tokens. Changing it logs everyone out.
PORTAL_SECRET_KEY=change-me
# true when the portal is served over https (production). false in the lab: http on localhost.
SESSION_COOKIE_SECURE=false
# JSON API (docs/api/v1.md): a Bearer token ends this many minutes after login (1-30). No refresh:
# the app logs in again. A password change or a disabled account ends every token at once.
API_TOKEN_MINUTES=15
# Wi-Fi network name put into the setup profiles (/setup and the Android app)
WIFI_SSID=NITS-Lab
# yes = Apple .mobileconfig profiles are CMS-signed (the device shows the signer);
# no = unsigned profiles (the device shows "Unsigned"). Used from stage S3.
# The signing certificate and key are certs/profile-sign.pem and certs/profile-sign.key (made by
# certs/make-certs.sh). With yes and no readable key, the Apple download fails (503): the portal
# never gives an unsigned profile in place of a signed one.
PROFILE_SIGNING=yes

# --- phpLDAPadmin ---
PLA_APP_KEY=base64:change-me
TZ=Asia/Kolkata
