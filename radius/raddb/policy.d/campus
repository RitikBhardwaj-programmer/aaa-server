# Campus authorization policy (the second "A" of AAA).
# Runs after the password is verified. The LDAP group decides the VLAN and the Class.
#
#   group      VLAN
#   faculty    20
#   staff      20
#   students   10
#   guests     30
#   disabled   -> Access-Reject (checked first, so it overrides every other group)
#   no group   -> Access-Reject
#
# Session-Timeout + Termination-Action = RADIUS-Request make the AP re-check every user
# every REAUTH_INTERVAL seconds (.env) WITHOUT disconnecting them. A user disabled in LDAP
# fails the next re-check, so access ends within REAUTH_INTERVAL even on APs that ignore
# RADIUS Disconnect-Requests (scripts/disable-user.ps1 sends those for instant cut-off).
#
# Class carries the group name; the AP echoes it in every accounting packet,
# so accounting records show which group each session belongs to.
#
# Acct-Interim-Interval asks the AP for an accounting update every ACCT_INTERIM_INTERVAL
# seconds. The device limit and the stale-session reaper rely on these updates.
#
# Students may use DEVICE_LIMIT_STUDENTS devices at the same time (policy device_limit below).
campus_authorize {
	if (LDAP-Group == "disabled") {
		update reply {
			&Reply-Message := "Account disabled. Contact the network office."
		}
		reject
	}
	elsif (LDAP-Group == "faculty") {
		update reply {
			&Session-Timeout := $ENV{REAUTH_INTERVAL}
			&Termination-Action := RADIUS-Request
			&Tunnel-Type := VLAN
			&Tunnel-Medium-Type := IEEE-802
			&Tunnel-Private-Group-Id := "20"
			&Class := "faculty"
			&Reply-Message := "Welcome, faculty member."
		}
	}
	elsif (LDAP-Group == "staff") {
		update reply {
			&Session-Timeout := $ENV{REAUTH_INTERVAL}
			&Termination-Action := RADIUS-Request
			&Tunnel-Type := VLAN
			&Tunnel-Medium-Type := IEEE-802
			&Tunnel-Private-Group-Id := "20"
			&Class := "staff"
			&Reply-Message := "Welcome, staff member."
		}
	}
	elsif (LDAP-Group == "students") {
		update reply {
			&Session-Timeout := $ENV{REAUTH_INTERVAL}
			&Termination-Action := RADIUS-Request
			&Tunnel-Type := VLAN
			&Tunnel-Medium-Type := IEEE-802
			&Tunnel-Private-Group-Id := "10"
			&Class := "students"
			&Reply-Message := "Welcome, student."
		}
		update control {
			&Tmp-Integer-0 := $ENV{DEVICE_LIMIT_STUDENTS}
		}
	}
	elsif (LDAP-Group == "guests") {
		update reply {
			&Session-Timeout := $ENV{REAUTH_INTERVAL}
			&Termination-Action := RADIUS-Request
			&Tunnel-Type := VLAN
			&Tunnel-Medium-Type := IEEE-802
			&Tunnel-Private-Group-Id := "30"
			&Class := "guests"
			&Reply-Message := "Welcome, guest."
		}
	}
	else {
		update reply {
			&Reply-Message := "No Wi-Fi access group assigned."
		}
		reject
	}

	update reply {
		&Acct-Interim-Interval := $ENV{ACCT_INTERIM_INTERVAL}
	}

	device_limit
}

# Device limit: a user may have at most control:Tmp-Integer-0 devices online at the same time
# (set by group in campus_authorize; 0 or unset = no limit).
# It counts DISTINCT device MACs with an open, recently updated session in radacct, except
# the device logging in now. So roaming between APs (two rows, one MAC) and the device's own
# re-check do not count twice, and a session with no update for STALE_SESSION_MINUTES
# (lost Stop) does not count at all.
#   DEVICE_LIMIT_MODE=soft     log the event in device_limit_events, let the device in
#   DEVICE_LIMIT_MODE=enforce  log the event and reject the device
# If PostgreSQL is down the count is 0, so the limit fails open and logins still work.
# Limits (inference, see the IIT Delhi plan review): PMK-cached and FT reconnects skip RADIUS,
# and accounting arrives a few seconds late, so two devices joining at the same moment can
# both pass.
device_limit {
	if (&control:Tmp-Integer-0 && (&control:Tmp-Integer-0 > 0)) {
		update control {
			&Tmp-Integer-1 := "%{%{sql:SELECT COUNT(DISTINCT CallingStationId) FROM radacct \
				WHERE UserName = '%{%{control:Tmp-String-5}:-%{User-Name}}' AND AcctStopTime IS NULL \
				AND AcctUpdateTime > NOW() - INTERVAL '$ENV{STALE_SESSION_MINUTES} minutes' \
				AND CallingStationId <> '%{Calling-Station-Id}'}:-0}"
		}
		if (&control:Tmp-Integer-1 >= &control:Tmp-Integer-0) {
			update control {
				&Tmp-String-1 := "%{sql:INSERT INTO device_limit_events \
					(username, callingstationid, live_devices, device_limit, mode) \
					VALUES ('%{%{control:Tmp-String-5}:-%{User-Name}}', '%{Calling-Station-Id}', %{control:Tmp-Integer-1}, \
					%{control:Tmp-Integer-0}, '$ENV{DEVICE_LIMIT_MODE}')}"
				# $ENV{} is expanded only in values like these, not inside a condition
				&Tmp-String-2 := "$ENV{DEVICE_LIMIT_MODE}"
			}
			if (&control:Tmp-String-2 == "enforce") {
				update reply {
					&Reply-Message := "Device limit reached: %{control:Tmp-Integer-0} devices are already online. Disconnect one and try again."
				}
				reject
			}
		}
	}
}

# Reject rate limit, used instead of account lockout. After AUTH_REJECT_LIMIT rejects for one
# user from one device (MAC) in AUTH_REJECT_WINDOW minutes, that device is refused without
# checking the password. Other devices of the same user are not affected, so an attacker who
# guesses passwords cannot lock the real student out (a lockout would let them).
# If PostgreSQL is down the count is 0 and the check is skipped.
reject_rate_limit {
	# Without a device MAC there is nothing to key the limit on (real APs always send one)
	if (&Calling-Station-Id) {
		update control {
			&Tmp-Integer-2 := "%{%{sql:SELECT COUNT(*) FROM radpostauth \
				WHERE username = '%{%{control:Tmp-String-5}:-%{User-Name}}' AND reply = 'Access-Reject' \
				AND CallingStationId = '%{Calling-Station-Id}' \
				AND authdate > NOW() - INTERVAL '$ENV{AUTH_REJECT_WINDOW} minutes'}:-0}"
			&Tmp-Integer-3 := $ENV{AUTH_REJECT_LIMIT}
		}
		if (&control:Tmp-Integer-2 >= &control:Tmp-Integer-3) {
			update reply {
				&Reply-Message := "Too many failed logins from this device. Wait $ENV{AUTH_REJECT_WINDOW} minutes."
			}
			reject
		}
	}
}

# Both limits above count by control:Tmp-String-5, the uid as stored in LDAP (set by the ldap
# module). The typed name can differ in case ("24it001" logs in as 24IT001), and counting by
# the typed name would let a student pass the device limit by changing the case.

# PEAP gate (inner tunnel, first thing in authorize). PEAP-MSCHAPv2 needs the weak NT hash and
# cannot work with a Kerberos password store. ALLOW_PEAP=yes keeps it for devices not yet moved
# to EAP-TTLS/PAP; ALLOW_PEAP=no refuses it.
# Test: an inner request that carries EAP is PEAP (or TTLS with inner EAP-MSCHAPv2, which needs
# the NT hash too). EAP-TTLS/PAP sends a plain User-Password and is never refused here.
# (In the outer server EAP-Type is not decoded before the eap module runs, so it cannot gate there.)
peap_gate {
	if (&EAP-Message) {
		update control {
			&Tmp-String-3 := "$ENV{ALLOW_PEAP}"
		}
		if (&control:Tmp-String-3 != "yes") {
			update reply {
				&Reply-Message := "PEAP is turned off. Set up the network with EAP-TTLS and PAP."
			}
			reject
		}
	}
}

# Password check. PASSWORD_BACKEND=ldap: LDAP bind as the user (the only backend set up now).
# PASSWORD_BACKEND=krb5 is reserved for a later move to Kerberos (rlm_krb5 against an MIT KDC,
# see docs/decisions/0001-ldap-now-kerberos-later.md); until that is built it rejects clearly
# instead of falling back to another check. Call it right after the ldap module.
password_backend {
	if ((ok || updated) && &User-Password && !&control:Auth-Type) {
		update control {
			&Tmp-String-4 := "$ENV{PASSWORD_BACKEND}"
		}
		if (&control:Tmp-String-4 == "ldap") {
			update control {
				&Auth-Type := ldap
			}
		}
		else {
			update reply {
				&Reply-Message := "Password backend '%{control:Tmp-String-4}' is not set up."
			}
			reject
		}
	}
}
