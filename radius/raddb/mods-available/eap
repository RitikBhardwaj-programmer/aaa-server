# EAP: PEAP (inner EAP-MSCHAPv2), EAP-TTLS (inner PAP) and EAP-TLS (device certificates of the portal).
# Weak methods (MD5, GTC, LEAP) are not loaded.
# EAP-TTLS/PAP is the default: it sends the password, so the server can check the {ARGON2} hash.
# MSCHAPv2 (PEAP) needs the weak NT hash instead. PEAP stays available while ALLOW_PEAP=yes
# (policy peap_gate in policy.d/campus), until existing devices move to TTLS.
eap {
	default_eap_type = ttls
	timer_expire = 60
	ignore_unknown_eap_types = no
	cisco_accounting_username_bug = no
	max_sessions = ${max_requests}

	tls-config tls-common {
		private_key_file = ${certdir}/lab/server.key
		certificate_file = ${certdir}/lab/server.pem
		ca_file = ${certdir}/lab/ca.pem
		cipher_list = "HIGH:!aNULL:!MD5:!RC4:!3DES"
		cipher_server_preference = yes
		tls_min_version = "1.2"
		# TLS 1.3 inside PEAP/TTLS is still unreliable on many clients
		tls_max_version = "1.2"
		ecdh_curve = ""

		cache {
			enable = no
		}
		verify {
		}
		ocsp {
			enable = no
		}
	}

	# EAP-TLS: the device proves itself with a certificate of the Device CA (portal/pki.py), no
	# password. The server certificate is the same as for TTLS. Checks, in this order:
	#   1. OpenSSL: the chain ends at the lab root through the Device CA, and the certificate is
	#      within its dates (device-chain.pem = Device CA + root, made by radius-start.sh);
	#   2. check_cert_issuer: issued by the Device CA itself, never by the root directly (the root
	#      also signs the RADIUS server and the profile-signing certificates);
	#   3. check_cert_cn: the CN is exactly the EAP identity (User-Name);
	#   4. sites-available/check-eap-tls: the serial is active in device_certs for that user (the
	#      revocation check), then LDAP and campus_authorize, as for TTLS.
	tls-config tls-device {
		private_key_file = ${certdir}/lab/server.key
		certificate_file = ${certdir}/lab/server.pem
		ca_file = ${certdir}/lab/device-chain.pem
		cipher_list = "HIGH:!aNULL:!MD5:!RC4:!3DES"
		cipher_server_preference = yes
		tls_min_version = "1.2"
		# Same as tls-common: TLS 1.3 (RFC 9190) is not yet tested on the lab clients
		tls_max_version = "1.2"
		ecdh_curve = ""

		# Same issuer name as certs/make-certs.sh (DEVICE_CA_CN): change both together
		check_cert_issuer = "/C=IN/O=NIT Srinagar/OU=Network Lab/CN=NIT Srinagar Device CA"
		check_cert_cn = %{User-Name}

		# No resumption: every login runs the full handshake, so check-eap-tls sees every login
		cache {
			enable = no
		}
		verify {
		}
		# Revocation is the table lookup in check-eap-tls, not OCSP or a CRL
		ocsp {
			enable = no
		}
	}

	tls {
		tls = tls-device
		virtual_server = "check-eap-tls"
	}

	ttls {
		tls = tls-common
		default_eap_type = mschapv2
		copy_request_to_tunnel = no
		use_tunneled_reply = no
		virtual_server = "inner-tunnel"
	}

	peap {
		tls = tls-common
		default_eap_type = mschapv2
		copy_request_to_tunnel = no
		use_tunneled_reply = no
		virtual_server = "inner-tunnel"
	}

	mschapv2 {
		send_error = no
	}
}
