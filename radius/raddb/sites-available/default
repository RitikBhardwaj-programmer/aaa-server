# Outer RADIUS server: receives Access-Request from the AP (and test tools) and Accounting-Request.
# Wi-Fi users arrive with EAP (PEAP / TTLS); the real identity is checked in sites-available/inner-tunnel.
# Plain PAP (radtest) is also accepted, so the LDAP path can be tested without EAP.
server default {

listen {
	type = auth
	ipaddr = *
	port = 0
	limits {
		max_connections = 16
		lifetime = 0
		idle_timeout = 30
	}
}

listen {
	type = acct
	ipaddr = *
	port = 0
}

# --- Authentication: who are you? ---
authorize {
	filter_username
	preprocess
	# MAC as AA-BB-CC-DD-EE-FF, the same form as in accounting (the device limit compares them)
	rewrite_calling_station_id

	# EAP conversation in progress: the eap module handles it
	eap {
		ok = return
	}

	# Non-EAP request (e.g. radtest with PAP): look the user up in LDAP and check the password
	# with an LDAP bind. The rate limit runs after the lookup, so it counts
	# by the stored uid, and before the password check, so a limited device gets no check.
	if (!EAP-Message) {
		ldap
		password_check
		reject_rate_limit
	}
}

authenticate {
	Auth-Type LDAP {
		ldap
	}
	eap
}

# --- Accounting: what happened? ---
preacct {
	preprocess
	rewrite_calling_station_id
	campus_acct_unique
}

accounting {
	# Plain-text copy per NAS per day, exactly as received (Event-Timestamp = the AP's clock):
	# /var/log/freeradius/radacct/<nas-ip>/detail-YYYYMMDD
	detail

	# From here on, times are the server's receive time minus the AP's queueing delay.
	# AP clocks can be wrong (the lab AP reports 2024), and CERT-In needs trusted time.
	update request {
		&Event-Timestamp := "%{expr:%l - %{%{Acct-Delay-Time}:-0}}"
	}

	# Queryable copy: spooled, then stored in PostgreSQL table radacct (sites-available/buffered-sql)
	sql_spool
	attr_filter.accounting_response
}

session {
}

# --- Authorization: what may you do? ---
post-auth {
	# For EAP the policy already ran in the inner tunnel; its result is in session-state
	if (!EAP-Message) {
		campus_authorize
		# Accounting and logs use the uid as stored in LDAP, not the typed form
		update reply {
			&User-Name := &control:Tmp-String-5
		}
	}

	# Copy only the inner-tunnel result. ":=" replaces the outer "anonymous" User-Name
	# instead of adding a second one. Missing attributes are skipped.
	update reply {
		&User-Name := &session-state:User-Name
		&Session-Timeout := &session-state:Session-Timeout
		&Termination-Action := &session-state:Termination-Action
		&Tunnel-Type := &session-state:Tunnel-Type
		&Tunnel-Medium-Type := &session-state:Tunnel-Medium-Type
		&Tunnel-Private-Group-Id := &session-state:Tunnel-Private-Group-Id
		&Class := &session-state:Class
		&Acct-Interim-Interval := &session-state:Acct-Interim-Interval
	}

	# EAP-TLS: the policy and the certificate check ran in sites-available/check-eap-tls, which put
	# the stored uid in reply:User-Name and the serial in reply:Tmp-String-7. Remember which device
	# used which certificate (table device_cert_seen: the portal's pki.certs_for_mac, and the
	# Disconnect after a revoke). The SELECT inserts nothing for an unknown serial, so the INSERT
	# cannot fail on the foreign key; with PostgreSQL down it writes nothing and the login goes on.
	if (&reply:Tmp-String-7) {
		if (&Calling-Station-Id) {
			update control {
				&Tmp-String-8 := "%{sql:INSERT INTO device_cert_seen (serial, username, callingstationid) \
					SELECT serial, username, '%{Calling-Station-Id}' FROM device_certs \
					WHERE serial = '%{reply:Tmp-String-7}' AND username = '%{reply:User-Name}' \
					ON CONFLICT (serial, callingstationid) DO UPDATE SET last_seen = now()}"
			}
		}
		update reply {
			&Tmp-String-7 !* ANY
		}
	}

	# Log the accept in PostgreSQL table radpostauth. If the database is down, log nothing
	# but still accept (fail = 1 stops a database error from turning into a reject).
	sql {
		fail = 1
	}
	remove_reply_message_if_eap

	Post-Auth-Type REJECT {
		# Log the reject under the stored uid (PAP; EAP sets it in the inner tunnel).
		# attr_filter.access_reject removes it from the reply again.
		if (!EAP-Message) {
			update reply {
				&User-Name := &control:Tmp-String-5
			}
		}
		sql
		attr_filter.access_reject
		eap
		remove_reply_message_if_eap
	}
}
}
