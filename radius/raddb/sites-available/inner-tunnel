# Inner server: runs inside the PEAP / EAP-TTLS TLS tunnel with the user's real identity.
#   PEAP      -> inner EAP-MSCHAPv2 -> NT hash from LDAP (sambaNTPassword)
#   EAP-TTLS  -> inner PAP          -> LDAP bind as the user
server inner-tunnel {

listen {
	ipaddr = 127.0.0.1
	port = 18120
	type = auth
}

authorize {
	filter_username

	# The inner request has no Calling-Station-Id (copy_request_to_tunnel = no); the rate limit
	# and the device limit need the device MAC, so take it from the outer request.
	update request {
		&Calling-Station-Id := &outer.request:Calling-Station-Id
	}

	# Refuse PEAP-MSCHAPv2 when ALLOW_PEAP=no (policy.d/campus)
	peap_gate

	mschap

	eap {
		ok = return
	}

	ldap
	# Password check with the configured backend (LDAP bind now; policy.d/campus)
	password_backend
	# After the lookup (counts by the stored uid), before the password check
	reject_rate_limit

	# Converts the hex NT hash from LDAP to binary, as mschap needs. Auth-Type is already set above.
	pap
}

authenticate {
	Auth-Type LDAP {
		ldap
	}
	Auth-Type MS-CHAP {
		mschap
	}
	eap
}

session {
}

post-auth {
	# Authorization: LDAP group -> reject, or re-check interval + VLAN (policy.d/campus)
	campus_authorize

	# Hand the result to the outer server, which puts it in the final Access-Accept.
	# User-Name lets the AP use the real identity (not "anonymous") in accounting.
	update outer.session-state {
		&User-Name := &request:User-Name
		&Session-Timeout := &reply:Session-Timeout
		&Termination-Action := &reply:Termination-Action
		&Tunnel-Type := &reply:Tunnel-Type
		&Tunnel-Medium-Type := &reply:Tunnel-Medium-Type
		&Tunnel-Private-Group-Id := &reply:Tunnel-Private-Group-Id
		&Class := &reply:Class
		&Acct-Interim-Interval := &reply:Acct-Interim-Interval
	}
	# Prefer the uid as stored in LDAP over the typed form (case can differ)
	update outer.session-state {
		&User-Name := &control:Tmp-String-5
	}

	Post-Auth-Type REJECT {
		update outer.session-state {
			&User-Name := &request:User-Name
		}
		update outer.session-state {
			&User-Name := &control:Tmp-String-5
		}
		attr_filter.access_reject
	}
}
}
