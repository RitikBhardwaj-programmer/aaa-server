    <!-- Wi-Fi setup -->
    <string name="wifi_title">Set up Wi-Fi</string>
    <string name="wifi_intro">The app saves the NITS-Lab network with the right security settings: EAP-TTLS with PAP, the lab CA certificate, and the server name check. Then the phone connects by itself.</string>
    <string name="wifi_password">Your Wi-Fi password (the portal password)</string>
    <string name="wifi_password_help">Android keeps it with the network. The app does not store it.</string>
    <string name="wifi_button">Set up Wi-Fi</string>
    <string name="wifi_settings">Network %1$s · user %2$s · server %3$s</string>
    <string name="wifi_android10">Android 10: the phone shows a notification \"Allow suggested Wi-Fi networks?\". Tap Allow.</string>
    <string name="wifi_android11">Android shows a screen \"Save this network?\". Tap Save.</string>
    <string name="wifi_mac_note">The app asks Android to keep one fixed Wi-Fi address for NITS-Lab, so this phone counts as one device. On Samsung phones, check Settings &gt; Wi-Fi &gt; NITS-Lab &gt; MAC address type: keep \"Randomized MAC\" (it stays the same for this network) or choose \"Phone MAC\".</string>

